{
  "expo": {
    "name": "Numerik",
    "slug": "numerik-mobile",
    "version": "2026.01",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E2A9E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.namamu.numerik"
    },
    "android": {
      "package": "com.namamu.numerik",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E2A9E"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "numerik",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7b4418a0-d3d2-49f6-8342-58ff149dc491"
      }
    }
  }
}
