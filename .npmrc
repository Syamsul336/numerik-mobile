# Bantu install ketika ada peer dependency conflict
# (terutama untuk react-native-svg-charts yang masih nyebut peer dep React lama)
legacy-peer-deps=true

# Biar npm nggak ngambek kalau versi Node sedikit beda dari `engines`
engine-strict=false

# Tambah waktu retry untuk koneksi yang lambat
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
