# =============================================================================
# CONTOH FILE .env (jangan commit file .env yang asli ke GitHub!)
# =============================================================================
# Cara pakai:
# 1. Copy file ini, rename jadi .env (tanpa .example)
# 2. Ganti nilainya dengan API key Anda
# 3. File .env sudah otomatis di-ignore oleh git (lihat .gitignore)
#
# Untuk DEPLOY ke Vercel, JANGAN upload file .env. Sebagai gantinya, set
# environment variable lewat dashboard Vercel:
# Project Settings → Environment Variables → Add New
# =============================================================================

GEMINI_API_KEY=AIzaSy_paste_api_key_gemini_anda_disini
